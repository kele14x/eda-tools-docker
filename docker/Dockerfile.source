# Use the bundled Dockerfile frontend so offline builds do not pull a syntax image.
ARG DEPENDENCIES_IMAGE=dependencies
ARG XLS_FETCH_BASE_IMAGE=yosys-fetch
FROM ubuntu:24.04 AS runtime-base
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates python3 libstdc++6 libgcc-s1 libffi8 libreadline8t64 \
      libtomlplusplus3t64 tcl8.6 zlib1g libtinfo6 libxml2 \
      libx11-6 libx11-xcb1 libsm6 libice6 libxcb1 libxcb-cursor0 libxcb-icccm4 \
      libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render0 \
      libxcb-render-util0 libxcb-shape0 libxcb-shm0 libxcb-sync1 \
      libxcb-util1 libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 libdbus-1-3 \
      libfontconfig1 libxkbcommon0 libxkbcommon-x11-0 \
    && rm -rf /var/lib/apt/lists/*

FROM runtime-base AS builder-base
COPY docker/install-build-deps.py /opt/build/install-build-deps.py
RUN DEBIAN_FRONTEND=noninteractive python3 /opt/build/install-build-deps.py \
    && rm -rf /var/lib/apt/lists/*
COPY config/tools/ /opt/eda/manifests/
COPY docker/build-source-tools.py docker/runtime_checksums.py /opt/build/
# Egress proxies block one of Bazel's two registry endpoints at a time, and which one varies
# between builds, so search both: the canonical registry first, then its verbatim GitHub mirror.
# Pass an empty value to use only Bazel's default registry.
ARG BAZEL_REGISTRY=https://bcr.bazel.build,https://raw.githubusercontent.com/bazelbuild/bazel-central-registry/main
ENV BAZEL_REGISTRY=$BAZEL_REGISTRY
# releases.bazel.build is unreachable behind some egress proxies, so bazelisk cannot fetch the
# Bazel that OpenROAD and XLS pin. The GCS bucket backing that domain is usually allowed and
# serves byte-identical artifacts under the same path. BAZELISK_BASE_URL cannot express this
# because it appends /<version>/<file> and omits the /release/ segment. Pass an empty value to
# restore bazelisk's default release server.
ARG BAZEL_URL_FORMAT=https://storage.googleapis.com/bazel/%v/release/bazel-%v-%o-%m%e
ENV BAZELISK_FORMAT_URL=$BAZEL_URL_FORMAT
ARG TARGETARCH
RUN --mount=type=cache,id=eda-bootstrap-cache,target=/var/cache/eda,sharing=locked \
    python3 /opt/build/build-source-tools.py bootstrap "$TARGETARCH" \
    && useradd --create-home --uid 1001 builder \
    && mkdir -p /src /opt/eda /var/cache/eda \
    && chown -R builder:builder /src /opt/eda
RUN --network=none mkdir -p /var/cache/eda && chown builder:builder /var/cache/eda
USER builder
WORKDIR /src
ENV HOME=/home/builder ASPECT_TOOLS_TELEMETRY=-all

FROM builder-base AS openroad-fetch
COPY docker/openroad-parser-eof.patch /opt/build/openroad-parser-eof.patch
# OpenROAD (and its embedded OpenSTA) is opt-in. It is the only stage that needs the
# multi-gigabyte OpenROAD source/submodule/Bazel fetch, which is the usual failure point on slow or
# restricted links, so the default image ships XLS, Yosys, and the ASAP7/Nangate45 libraries only.
# Pass --build-arg OPENROAD_ENABLED=ON to add the place-and-route and STA tools.
ARG OPENROAD_ENABLED=OFF
# The Qt GUI is off by default. The browser viewer (-web) is unaffected: it is wired up by
# src/gui's non-Qt makeGui.cpp stub, so layout viewing and the smoke-test viewer still work.
# Only the native Qt display (startGui) and save_image are unavailable. Pass ON to build Qt.
ARG OPENROAD_GUI=OFF
ARG BAZEL_FETCH_TIMEOUT=1800
ENV OPENROAD_GUI=$OPENROAD_GUI BAZEL_FETCH_TIMEOUT=$BAZEL_FETCH_TIMEOUT
# The host ./downloads directory is mounted read-only as a download seed: any complete archive
# already there is copied into the persistent cache mount before fetching, so files prepared on
# another machine (or before a network outage) are reused instead of re-downloaded. BuildKit cannot
# write back to a named context, so the cache mount stays the authoritative store; ./downloads only
# seeds it. A seed only replaces a cached file that is missing or incomplete -- never the reverse --
# so a stale partial left by an interrupted fetch (which download_restarting cannot resume, because
# codeload ignores Range requests) is overwritten by the complete host copy rather than blocking it.
RUN --mount=type=cache,id=eda-source-cache,target=/var/cache/eda,uid=1001,gid=1001,sharing=locked \
    --mount=type=bind,from=downloads,source=/,target=/downloads-seed,readonly \
    if [ "$OPENROAD_ENABLED" = ON ]; then \
      mkdir -p /var/cache/eda/downloads \
      && if [ -d /downloads-seed ]; then \
           echo 'DOWNLOAD SEED: copying prepared archives from ./downloads'; \
           for seed in /downloads-seed/*.tar.gz; do \
             [ -f "$seed" ] || continue; \
             base=$(basename "$seed"); dest="/var/cache/eda/downloads/$base"; \
             if ! tar -tzf "$seed" >/dev/null 2>&1; then \
               echo "DOWNLOAD SEED: skip incomplete seed $base"; continue; \
             fi; \
             if [ -f "$dest" ] && tar -tzf "$dest" >/dev/null 2>&1; then \
               echo "DOWNLOAD SEED: keep complete cached $base"; \
             else \
               cp -a "$seed" "$dest" && echo "DOWNLOAD SEED: seeded $base"; \
             fi; \
           done; \
         fi \
      && python3 /opt/build/build-source-tools.py fetch openroad 1 "$OPENROAD_GUI"; \
    else \
      echo 'OPENROAD_ENABLED=OFF: skipping OpenROAD fetch (no P&R/STA in this image)'; \
    fi

FROM openroad-fetch AS yosys-fetch
RUN python3 /opt/build/build-source-tools.py fetch yosys 1

FROM ${XLS_FETCH_BASE_IMAGE} AS xls-fetch
ARG TARGETARCH
ARG XLS_INSTALL_MODE=auto
ARG BAZEL_FETCH_TIMEOUT=1800
ENV BAZEL_FETCH_TIMEOUT=$BAZEL_FETCH_TIMEOUT
ENV XLS_INSTALL_MODE=$XLS_INSTALL_MODE
COPY docker/build-source-tools.py docker/runtime_checksums.py /opt/build/
COPY docker/install-xls-release.py /opt/build/install-xls-release.py
RUN --mount=type=cache,id=eda-source-cache,target=/var/cache/eda,uid=1001,gid=1001,sharing=locked \
    case "$XLS_INSTALL_MODE:$TARGETARCH" in \
      auto:amd64|release:amd64) python3 /opt/build/install-xls-release.py fetch ;; \
      auto:arm64|source:amd64|source:arm64) python3 /opt/build/build-source-tools.py fetch xls 1 ;; \
      *) echo "Unsupported XLS_INSTALL_MODE/TARGETARCH: $XLS_INSTALL_MODE/$TARGETARCH (use auto, source or release; release requires AMD64)" >&2; exit 2 ;; \
    esac
RUN python3 /opt/build/build-source-tools.py libraries

FROM runtime-base AS runtime-packages
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        iverilog verilator build-essential zlib1g-dev \
    && mkdir -p /opt/eda/manifests \
    && dpkg-query -W iverilog verilator build-essential g++ make perl zlib1g-dev \
        > /opt/eda/manifests/simulation-packages.txt \
    && rm -rf /var/lib/apt/lists/*

FROM xls-fetch AS dependencies
COPY --from=runtime-packages / /opt/runtime-root/

# Override with a local prepared image to skip every online stage.
FROM ${DEPENDENCIES_IMAGE} AS prepared
ENV GIT_NO_LAZY_FETCH=1

FROM prepared AS openroad-build
ARG BUILD_JOBS=4
ARG OPENROAD_ENABLED=OFF
RUN --network=none --mount=type=cache,id=eda-bazel-actions,target=/home/builder/.cache/bazel-disk-cache,uid=1001,gid=1001,sharing=locked \
    if [ "$OPENROAD_ENABLED" = ON ]; then \
      python3 /opt/build/build-source-tools.py build openroad "$BUILD_JOBS" "$OPENROAD_GUI"; \
    else \
      echo 'OPENROAD_ENABLED=OFF: skipping OpenROAD build'; \
    fi

FROM openroad-build AS yosys-build
ARG BUILD_JOBS=4
RUN --network=none python3 /opt/build/build-source-tools.py build yosys "$BUILD_JOBS"

FROM yosys-build AS xls-build
ARG BUILD_JOBS=4
ARG TARGETARCH
RUN --network=none --mount=type=cache,id=eda-bazel-actions,target=/home/builder/.cache/bazel-disk-cache,uid=1001,gid=1001,sharing=locked \
    case "$XLS_INSTALL_MODE:$TARGETARCH" in \
      auto:amd64|release:amd64) python3 /opt/build/install-xls-release.py install ;; \
      auto:arm64|source:amd64|source:arm64) python3 /opt/build/build-source-tools.py build xls "$BUILD_JOBS" ;; \
      *) echo "Unsupported XLS_INSTALL_MODE/TARGETARCH: $XLS_INSTALL_MODE/$TARGETARCH (use auto, source or release; release requires AMD64)" >&2; exit 2 ;; \
    esac

FROM scratch AS runtime
LABEL org.opencontainers.image.title="XLS, Yosys, OpenROAD, Icarus Verilog, and Verilator native toolchain" \
      org.opencontainers.image.description="Native synthesis, simulation, timing, and physical design with ASAP7 and Nangate45" \
      org.opencontainers.image.version="v1-source"
ARG OPENROAD_ENABLED=OFF
COPY --from=prepared /opt/runtime-root/ /
COPY --from=xls-build /opt/eda/ /opt/eda/
COPY docker/verify-installations.py docker/runtime_checksums.py /opt/eda/
COPY --chmod=755 docker/entrypoint.sh /usr/local/bin/eda-entrypoint
ENV PATH="/opt/eda/xls:/opt/eda/yosys/bin:/opt/eda/openroad/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    NANGATE45_LIBERTY="/opt/eda/nangate45/NangateOpenCellLibrary_typical.lib" \
    NANGATE45_TECH_LEF="/opt/eda/nangate45-physical/lef/NangateOpenCellLibrary.tech.lef" \
    NANGATE45_CELLS_LEF="/opt/eda/nangate45-physical/lef/NangateOpenCellLibrary.macro.mod.lef" \
    NANGATE45_RC="/opt/eda/nangate45-physical/setRC.tcl" \
    NANGATE45_RCX_RULES="/opt/eda/nangate45-physical/rcx_patterns.rules" \
    ASAP7_TECH_LEF="/opt/eda/asap7/lef/asap7_tech_1x_201209.lef" \
    ASAP7_CELLS_LEF="/opt/eda/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef" \
    ASAP7_LIBERTIES="/opt/eda/asap7/lib/NLDM/asap7sc7p5t_AO_RVT_TT_nldm_211120.lib.gz /opt/eda/asap7/lib/NLDM/asap7sc7p5t_INVBUF_RVT_TT_nldm_220122.lib.gz /opt/eda/asap7/lib/NLDM/asap7sc7p5t_OA_RVT_TT_nldm_211120.lib.gz /opt/eda/asap7/lib/NLDM/asap7sc7p5t_SIMPLE_RVT_TT_nldm_211120.lib.gz /opt/eda/asap7/lib/NLDM/asap7sc7p5t_SEQ_RVT_TT_nldm_220123.lib" \
    ASAP7_DFF_LIBERTY="/opt/eda/asap7/lib/NLDM/asap7sc7p5t_SEQ_RVT_TT_nldm_220123.lib" \
    ASAP7_RC="/opt/eda/asap7/setRC.tcl" \
    ASAP7_RCX_RULES="/opt/eda/asap7/rcx_patterns.rules" \
    ASAP7_TRACKS="/opt/eda/asap7/openRoad/make_tracks.tcl" \
    ASAP7_TAPCELL="/opt/eda/asap7/openRoad/tapcell.tcl" \
    ASAP7_SITE="asap7sc7p5t" \
    ASAP7_TIEHI_CELL="TIEHIx1_ASAP7_75t_R" \
    ASAP7_TIEHI_PORT="H" \
    ASAP7_TIELO_CELL="TIELOx1_ASAP7_75t_R" \
    ASAP7_TIELO_PORT="L" \
    ASAP7_CLOCK_BUFFER="BUFx2_ASAP7_75t_R" \
    ASAP7_CLOCK_BUFFERS="BUFx2_ASAP7_75t_R BUFx4_ASAP7_75t_R BUFx8_ASAP7_75t_R" \
    EDA_SMOKE_PLATFORM="asap7"
RUN --network=none ln -s eda-entrypoint /usr/local/bin/xls \
    && if [ "$OPENROAD_ENABLED" = ON ]; then \
         ln -s /opt/eda/openroad/bin/openroad /usr/local/bin/sta \
         && sta -version && openroad -version; \
       fi \
    && python3 /opt/eda/verify-installations.py \
    && xls interpreter_main --version && yosys -V \
    && iverilog -V && vvp -V && verilator --version
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/eda-entrypoint"]
CMD ["bash"]
