# Only the build scripts, pins, and the base rootfs; other downloads arrive as named contexts.
**
!docker/
!docker/Dockerfile.source
!docker/build-source-tools.py
!docker/install-apt-packages.sh
!docker/install-xls-release.py
!docker/openroad-parser-eof.patch
!docker/entrypoint.sh
!docker/runtime_checksums.py
!docker/verify-installations.py
!config/
!config/tools/
!config/tools/*.json
!config/apt/
!config/apt/*.txt
!downloads/linux-*/ubuntu-base.tar.gz
